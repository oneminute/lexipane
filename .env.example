# LexiPane does not use .env files for normal application settings.
#
# Application defaults live in:
#   src/config/appDefaults.ts
#
# User-changeable runtime settings are stored locally in SQLite/app_meta
# and configured from the LexiPane UI.
#
# Provider API keys are NEVER stored here. They use the operating system
# secure credential store.
#
# TAURI_DEV_HOST is a Tauri/Vite development-process variable and is normally
# supplied by the Tauri toolchain when needed; it is not an application setting.
