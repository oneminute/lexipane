{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LexiPane",
  "version": "0.1.0",
  "identifier": "com.lexipane.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LexiPane",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "http": {
      "scopeRedirects": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "AI-assisted ebook reader",
    "longDescription": "Cross-platform AI-assisted ebook reader for deep reading and language learning.",
    "resources": [
      "runtime/amule/**/*"
    ]
  }
}
