{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for LexiPane",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:11434" },
        { "url": "http://localhost:11434" }
      ]
    },
    "sql:default"
  ]
}
